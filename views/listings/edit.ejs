<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing</title>
</head>
<body>
    <h3>Edit Listing</h3>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PATCH">
        <input name="listing[title]" placeholder="Enter Name" type="text" value="<%=listing.title%>" required> <br/> <br/>
        <input name="listing[description]" placeholder="Enter description" type="text" value="<%=listing.description || ''%>"> <br/> <br/>
        <input name="listing[image][url]" placeholder="Enter image link/URL" type="url" value="<%=listing.image && listing.image.url ? listing.image.url : ''%>"> <br/> <br/>
        <input name="listing[price]" placeholder="Enter price" type="number" value="<%=listing.price || ''%>"> <br/> <br/>
        <input name="listing[location]" placeholder="Enter location" type="text" value="<%=listing.location || ''%>"> <br/> <br/>
        <input name="listing[country]" placeholder="Enter country" type="text" value="<%=listing.country || ''%>"> <br/> <br/>

        <button type="submit">Update</button>
    </form>
</body>
</html>